{
  "_comment": "EXAMPLE settings.json showing the full wosy hook wiring. NOT auto-deployed — install.sh only adds the watchdog matcher to your existing ~/.claude/settings.json. To use this as a starter: cp this file to ~/.claude/settings.json and replace every literal ${HOME} with your absolute home directory (e.g. sed -i.bak 's|\\${HOME}|'\"$HOME\"'|g' ~/.claude/settings.json). The other 14 hooks listed below must also exist at the referenced paths — copy them from claude/hooks/ first.",
  "env": {
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "400000",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash",
    "BASH_SILENCE_DEPRECATION_WARNING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
