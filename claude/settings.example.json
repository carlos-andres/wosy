  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/validate-bash.sh"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/canonicalize-bash.sh"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/secret-dump-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/write-location-warn.sh"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/md-hardwrap-warn.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/watchdog.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/wosy-stop.sh"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/handoff-vigilante.sh"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/output-telemetry.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/edit-batch-nudge.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/context-checkpoint.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/handoff-check.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/context-checkpoint.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/session-audit.sh"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/brain-reconcile.sh"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/handoff-vigilante.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/multi-step-pause.sh"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/brain-load-trigger.sh"
          },
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/handoff-vigilante.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/session-start-context.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${HOME}/.claude/statusline/statusline.sh"
  },
  "outputStyle": "Coworker",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "stable",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
