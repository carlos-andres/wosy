  "hooks": {
    "Notification": [],
    "PermissionRequest": [],
    "PostToolUse": [],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/.claude/hooks/dispatch-bash.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 /Users/you/.claude/hooks/secret_guard.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 /Users/you/.claude/hooks/secret_guard.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 /Users/you/.claude/hooks/session-audit.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/.claude/hooks/skill-consistency.sh"
          }
        ]
      },
      {
        "matcher": "^(startup|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/.claude/hooks/catalogue-loader.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [],
    "StopFailure": [],
    "SubagentStop": [],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 /Users/you/.claude/hooks/secret_guard.py"
          }
        ]
      }
    ]
  }
